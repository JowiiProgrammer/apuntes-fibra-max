                      "w": 7.44,
                      "h": 4.24,
                      "label": "Dar de alta y cobrar"
                    }
                  ]
                },
                {
                  "id": "aw-p-despues",
                  "type": "checklist",
                  "title": "Después de cobrar",
                  "items": [
                    "Agrega el contacto del cliente al teléfono",
                    "Escanea el alta y guárdala en la carpeta de OneDrive correspondiente",
                    "Tritura el alta"
                  ]
                }
              ],
              "children": [],
              "updatedAt": "2026-10-08"
            }
