              "type": "steps",
              "start": 10,
              "items": [
                {
                  "title": "Elige el bono y cobra",
                  "md": "Selecciona el **bono correspondiente** en el desplegable y pulsa **Crear y Cobrar**."
                },
                {
                  "title": "Método de pago",
                  "md": "Elige el método de pago: **efectivo** o **tarjeta** si paga en recepción, o **transferencia** si ya lo ha pagado online."
                }
              ]
            },
            {
              "id": "mp-shot-form",
              "type": "screenshot",
              "src": "/capturas/bonos-3-formulario-bono.png",
              "alt": "Formulario Bono de Matchpoint con el desplegable de bono y el botón Crear y Cobrar",
              "caption": "Formulario del bono: elige el bono y pulsa Crear y Cobrar.",
              "annotations": [
                {
                  "kind": "box",
                  "x": 30.56,
                  "y": 32.0,
                  "w": 44.51,
